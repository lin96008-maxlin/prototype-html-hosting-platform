# PostgreSQL 数据库与本地持久化目录
DATABASE_URL=postgresql://prototype_demo:change_me@postgres:5432/prototype_demo
POSTGRES_DB=prototype_demo
POSTGRES_USER=prototype_demo
POSTGRES_PASSWORD=
DATABASE_POOL_MAX=5
DATA_DIR=/data/prototype-hub

# 站点域名
NEXT_PUBLIC_BASE_PATH=/manage
MANAGE_URL=https://prototype-demo.example.com/manage
DEMO_URL=https://prototype-demo.example.com/manage
AUTH_COOKIE_DOMAIN=.example.com
ROOT_DOMAIN=example.com
SITE_DOMAIN=prototype-demo.example.com
APP_HOST_PORT=3000

# 至少 32 个随机字符，用于签发登录会话
SESSION_SIGNING_SECRET=
# 至少 32 个随机字符，用于加密可回填的分享密码；请勿与会话密钥相同
SHARE_PASSWORD_ENCRYPTION_KEY=
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# 原型上传保留 20% 磁盘空间给系统、数据库和备份
STORAGE_RESERVE_RATIO=0.2
BACKUP_REPOSITORY_PASSWORD=
# 同一平台保持固定，避免容器重建后被 Restic 识别为不同备份主机
BACKUP_HOSTNAME=prototype-demo

# 首位超级管理员初始化
BOOTSTRAP_SUPER_ADMIN_ACCOUNT=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=系统管理员
BOOTSTRAP_DEPARTMENT_NAME=产品中心

# 本地未配置 PostgreSQL 时自动进入演示模式；生产环境不会启用演示模式
DEMO_MODE=false
