#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT="/opt/prototype-hosting-platform-demo"
ENV_FILE="/etc/prototype-hosting-platform-demo/config"
COMPOSE_FILES=("-f" "$APP_ROOT/docker-compose.yml" "-f" "$APP_ROOT/docker-compose.server.yml")
ACTION="${1:-check}"
LOCK_FILE="/run/lock/prototype-hub-backup-maintenance.lock"

[[ "$ACTION" == "check" || "$ACTION" == "verify" ]] || {
  echo "仅支持 check 或 verify" >&2
  exit 1
}

exec 9>"$LOCK_FILE"
flock -n 9 || {
  echo "已有备份维护任务正在执行" >&2
  exit 1
}

compose() {
  docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" "$@"
}

backup_container="$(compose ps -q backup)"
[[ -n "$backup_container" ]] || {
  echo "backup 容器未运行" >&2
  exit 1
}

compose exec -T backup /usr/local/bin/backup-healthcheck.sh

if [[ "$ACTION" == "verify" ]]; then
  echo "开始隔离恢复验证；不会覆盖正式数据库和原型文件"
  compose exec -T backup /usr/local/bin/verify-backup.sh
fi

status="$(compose exec -T backup cat /status/backup-status.json)"
printf '%s\n' "$status"
compose exec -T backup restic snapshots --latest 1

read -r total_kb available_kb used_percent < <(df -Pk "$APP_ROOT" | awk 'NR == 2 {gsub(/%/, "", $5); print $2, $4, $5}')
echo "磁盘：总计 $((total_kb / 1024)) MB，剩余 $((available_kb / 1024)) MB，已用 ${used_percent}%"
if (( used_percent >= 85 )); then
  echo "磁盘使用率已达到 85% 告警线" >&2
  exit 1
fi
if (( used_percent >= 70 )); then
  echo "提醒：磁盘使用率已达到 70%，请评估清理或扩容"
fi
