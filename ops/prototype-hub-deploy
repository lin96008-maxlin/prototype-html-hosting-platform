#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

APP_ROOT="/opt/prototype-hosting-platform-demo"
ENV_FILE="/etc/prototype-hosting-platform-demo/config"
DEPLOY_HOME="/home/prototype-demo-deploy"
APP_CONTAINER="prototype_demo-prototype-app"
COMPOSE_FILES=("-f" "$APP_ROOT/docker-compose.yml" "-f" "$APP_ROOT/docker-compose.server.yml")
SHA="${1:-}"
RUN_ID="${2:-}"

fail() {
  echo "部署失败：$*" >&2
  exit 1
}

[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || fail "提交 SHA 格式不正确"
[[ "$RUN_ID" =~ ^[0-9]+-[0-9]+$ ]] || fail "GitHub Actions 运行编号格式不正确"

ARCHIVE="$DEPLOY_HOME/incoming/prototype_demo-${SHA}-${RUN_ID}.tar.gz"
RELEASE="$APP_ROOT/releases/${SHA}-${RUN_ID}"
SHORT_SHA="${SHA:0:12}"
IMAGE="prototype-hosting-platform-demo-app:release-${SHORT_SHA}-${RUN_ID}"
CANDIDATE="prototype_demo-candidate-${RUN_ID}"
CANDIDATE_PORT=3001
RUNTIME_ENV="/run/prototype-demo-deploy-${RUN_ID}.env"
LOCK_FILE="/run/lock/prototype-demo-deploy.lock"
PRODUCTION_MUTATED=0
OLD_IMAGE_ID=""
OLD_BACKUP_IMAGE_ID=""
BACKUP_IMAGE="prototype-hosting-platform-demo-backup:release-${SHORT_SHA}-${RUN_ID}"
BACKUP_LATEST_IMAGE="prototype-hosting-platform-demo-backup:latest"

exec 9>"$LOCK_FILE"
flock -n 9 || fail "已有部署任务正在执行"

[[ -f "$ARCHIVE" ]] || fail "未找到部署制品"
[[ -f "$ENV_FILE" ]] || fail "未找到生产环境配置"
[[ ! -e "$RELEASE" ]] || fail "该运行编号已经部署过"

cleanup() {
  docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
  rm -f "$RUNTIME_ENV" "$ARCHIVE"
}

restore_production() {
  echo "正式版本启动失败，正在恢复上一版本"
  [[ -n "$OLD_IMAGE_ID" ]] && docker tag "$OLD_IMAGE_ID" prototype-hosting-platform-demo-app:latest
  [[ -n "$OLD_BACKUP_IMAGE_ID" ]] && docker tag "$OLD_BACKUP_IMAGE_ID" "$BACKUP_LATEST_IMAGE"
  if [[ -f "$RELEASE/rollback/runtime-config.tar.gz" ]]; then
    tar -xzf "$RELEASE/rollback/runtime-config.tar.gz" -C "$APP_ROOT"
  fi
  docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" \
    up -d --no-deps --no-build --force-recreate app
  if [[ -n "$OLD_BACKUP_IMAGE_ID" ]]; then
    docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" \
      up -d --no-deps --no-build --force-recreate backup
  fi

  for _ in $(seq 1 90); do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$APP_CONTAINER" 2>/dev/null || true)"
    if [[ "$health" == "healthy" ]] && curl --fail --silent --show-error \
      "http://127.0.0.1:3000/manage/api/health" >/dev/null; then
      echo "上一正式版本已恢复"
      return 0
    fi
    sleep 2
  done

  docker logs --tail 120 "$APP_CONTAINER" >&2 || true
  return 1
}

on_exit() {
  status=$?
  trap - EXIT
  cleanup
  if [[ "$status" -ne 0 && "$PRODUCTION_MUTATED" -eq 1 ]]; then
    restore_production || echo "自动恢复失败，请立即人工检查服务器" >&2
  fi
  exit "$status"
}
trap on_exit EXIT

mkdir -p "$RELEASE" "$RELEASE/rollback"
while IFS= read -r entry; do
  if [[ "$entry" = /* || "$entry" == ../* || "$entry" == */../* || "$entry" == */.. ]]; then
    fail "部署制品包含不安全路径"
  fi
done < <(tar -tzf "$ARCHIVE")
tar --no-same-owner --no-same-permissions -xzf "$ARCHIVE" -C "$RELEASE"

for required in \
  Dockerfile.prebuilt \
  docker-compose.yml \
  docker-compose.server.yml \
  prebuilt/standalone/server.js \
  ops/prototype-demo-deploy \
  ops/prototype-hub-backup-maintenance; do
  [[ -e "$RELEASE/$required" ]] || fail "部署制品缺少 $required"
done

OLD_IMAGE_ID="$(docker inspect --format '{{.Image}}' "$APP_CONTAINER")"
docker image inspect "$OLD_IMAGE_ID" >/dev/null
BACKUP_CONTAINER="$(docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" ps -q backup)"
if [[ -n "$BACKUP_CONTAINER" ]]; then
  OLD_BACKUP_IMAGE_ID="$(docker inspect --format '{{.Image}}' "$BACKUP_CONTAINER")"
  docker image inspect "$OLD_BACKUP_IMAGE_ID" >/dev/null
fi

tar -czf "$RELEASE/rollback/runtime-config.tar.gz" -C "$APP_ROOT" \
  Dockerfile Dockerfile.prebuilt docker-compose.yml docker-compose.server.yml Caddyfile docker scripts database

POSTGRES_CONTAINER="$(docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" ps -q postgres)"
[[ -n "$POSTGRES_CONTAINER" ]] || fail "PostgreSQL 容器未运行"
docker exec "$POSTGRES_CONTAINER" sh -eu -c \
  'exec pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB"' \
  | gzip -9 > "$RELEASE/rollback/pre-deploy.sql.gz"

docker build \
  --build-arg NEXT_PUBLIC_BASE_PATH=/manage \
  -f "$RELEASE/Dockerfile.prebuilt" \
  -t "$IMAGE" \
  "$RELEASE"

docker build \
  -f "$RELEASE/docker/backup.Dockerfile" \
  -t "$BACKUP_IMAGE" \
  "$RELEASE"

docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$APP_CONTAINER" > "$RUNTIME_ENV"
chmod 600 "$RUNTIME_ENV"

APP_NETWORK=""
while IFS= read -r network; do
  if [[ -n "$network" && "$network" != "prototype-demo-edge" ]]; then
    APP_NETWORK="$network"
    break
  fi
done < <(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$APP_CONTAINER")
[[ -n "$APP_NETWORK" ]] || fail "未找到应用内部网络"

DATA_VOLUME="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data/prototype-hub"}}{{.Name}}{{end}}{{end}}' "$APP_CONTAINER")"
[[ -n "$DATA_VOLUME" ]] || fail "未找到原型持久化卷"

docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
docker run -d \
  --name "$CANDIDATE" \
  --init \
  --network "$APP_NETWORK" \
  --env-file "$RUNTIME_ENV" \
  -v "$DATA_VOLUME:/data/prototype-hub" \
  -p "127.0.0.1:${CANDIDATE_PORT}:3000" \
  "$IMAGE" >/dev/null

candidate_ready=0
for _ in $(seq 1 75); do
  if curl --fail --silent --show-error \
    "http://127.0.0.1:${CANDIDATE_PORT}/manage/api/health" >/dev/null; then
    candidate_ready=1
    break
  fi
  if [[ "$(docker inspect --format '{{.State.Running}}' "$CANDIDATE" 2>/dev/null || true)" != "true" ]]; then
    break
  fi
  sleep 2
done
if [[ "$candidate_ready" -ne 1 ]]; then
  docker logs --tail 120 "$CANDIDATE" >&2 || true
  fail "候选容器健康检查未通过"
fi
docker rm -f "$CANDIDATE" >/dev/null

PRODUCTION_MUTATED=1
docker tag "$OLD_IMAGE_ID" "prototype-hosting-platform-demo-app:rollback-${RUN_ID}"
docker tag "$IMAGE" prototype-hosting-platform-demo-app:latest
if [[ -n "$OLD_BACKUP_IMAGE_ID" ]]; then
  docker tag "$OLD_BACKUP_IMAGE_ID" "prototype-hosting-platform-demo-backup:rollback-${RUN_ID}"
fi
docker tag "$BACKUP_IMAGE" "$BACKUP_LATEST_IMAGE"

for file in Dockerfile Dockerfile.prebuilt docker-compose.yml docker-compose.server.yml Caddyfile; do
  install -m 0644 "$RELEASE/$file" "$APP_ROOT/$file"
done
for directory in docker scripts database; do
  mkdir -p "$APP_ROOT/$directory"
  cp -a "$RELEASE/$directory/." "$APP_ROOT/$directory/"
done

docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" \
  up -d --no-deps --no-build --force-recreate app
docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" \
  up -d --no-deps --no-build --force-recreate backup

production_ready=0
for _ in $(seq 1 90); do
  health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$APP_CONTAINER" 2>/dev/null || true)"
  if [[ "$health" == "healthy" ]] && curl --fail --silent --show-error \
    "http://127.0.0.1:3000/manage/api/health" >/dev/null; then
    production_ready=1
    break
  fi
  if [[ "$(docker inspect --format '{{.State.Running}}' "$APP_CONTAINER" 2>/dev/null || true)" != "true" ]]; then
    break
  fi
  sleep 2
done
if [[ "$production_ready" -ne 1 ]]; then
  docker logs --tail 120 "$APP_CONTAINER" >&2 || true
  fail "正式容器健康检查未通过"
fi

backup_ready=0
for _ in $(seq 1 300); do
  if docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" \
    exec -T backup /usr/local/bin/backup-healthcheck.sh >/dev/null 2>&1; then
    backup_ready=1
    break
  fi
  sleep 2
done
if [[ "$backup_ready" -ne 1 ]]; then
  docker compose --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}" logs --tail 160 backup >&2 || true
  fail "备份容器健康检查未通过"
fi

install -m 0750 -o root -g root "$RELEASE/ops/prototype-demo-deploy" /usr/local/sbin/prototype-demo-deploy
install -m 0750 -o root -g root \
  "$RELEASE/ops/prototype-hub-backup-maintenance" /usr/local/sbin/prototype-hub-backup-maintenance

cat > "$APP_ROOT/CURRENT_RELEASE.tmp" <<EOF
commit=$SHA
run_id=$RUN_ID
image=$IMAGE
deployed_at=$(date --iso-8601=seconds)
EOF
chmod 0644 "$APP_ROOT/CURRENT_RELEASE.tmp"
mv "$APP_ROOT/CURRENT_RELEASE.tmp" "$APP_ROOT/CURRENT_RELEASE"
PRODUCTION_MUTATED=0

echo "部署成功：$SHA（GitHub Actions $RUN_ID）"
