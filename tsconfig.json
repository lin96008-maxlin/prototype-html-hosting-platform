{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-basepath-smoke/types/**/*.ts",
    ".next-basepath-smoke/dev/types/**/*.ts",
    ".next-basepath-smoke-3201/types/**/*.ts",
    ".next-basepath-smoke-3201/dev/types/**/*.ts",
    ".next-basepath-smoke-3202/types/**/*.ts",
    ".next-basepath-smoke-3202/dev/types/**/*.ts",
    ".next-cli/types/**/*.ts",
    ".next-cli/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "output",
    "high-fidelity-prototype-ant-design"
  ]
}
